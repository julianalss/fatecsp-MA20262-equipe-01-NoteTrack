// =============================================================
// NoteTrack_03_PowerPivot.xlsx -- medidas preliminares (Etapa 3)
// Tabela-base de todas as medidas: fAnuncios
// Separador: vírgula (padrão). No Excel pt-BR, digitar com ";".
// =============================================================

// Quanto somam os preços anunciados no recorte? (medida de volume; base do preço médio) -- Moeda R$, 2 casas
Soma Preços := SUMX ( fAnuncios, fAnuncios[Preco_BRL] )

// Quantos anúncios válidos existem no recorte? (contagem distinta pelo código do anúncio) -- Inteiro, separador de milhar
Qtd Anúncios := DISTINCTCOUNT ( fAnuncios[ID_Anuncio] )

// Quanto custa, em média, um notebook do recorte? (KPI central do projeto) -- Moeda R$, 2 casas
Preço Médio := DIVIDE ( [Soma Preços], [Qtd Anúncios] )

// Qual o anúncio mais barato do recorte? -- Moeda R$, 2 casas
Preço Mínimo := MIN ( fAnuncios[Preco_BRL] )

// Qual o anúncio mais caro do recorte? -- Moeda R$, 2 casas
Preço Máximo := MAX ( fAnuncios[Preco_BRL] )

// Qual o preço médio de todos os anúncios, ignorando os filtros? (referência para comparar) -- Moeda R$, 2 casas
Preço Médio Geral := CALCULATE ( [Preço Médio], ALL ( fAnuncios ) )

// Quanto o recorte está acima (+) ou abaixo (-) da média geral? -- Porcentagem, 1 casa
Variação vs Média Geral % := DIVIDE ( [Preço Médio] - [Preço Médio Geral], [Preço Médio Geral] )

// Quantos modelos aparecem no recorte? -- Inteiro, separador de milhar
Qtd Modelos := DISTINCTCOUNT ( fAnuncios[Cod_Modelo] )

// Quantos GB de RAM somam os anúncios do recorte? (busca RAM_GB no cadastro dRAM pelo relacionamento) -- Inteiro, separador de milhar
RAM Total (GB) := SUMX ( fAnuncios, RELATED ( dRAM[RAM_GB] ) )

// Quanto se paga por GB de memória? (só anúncios com a RAM identificada) -- Moeda R$, 2 casas
Preço por GB de RAM := DIVIDE ( CALCULATE ( [Soma Preços], dRAM[RAM_GB] > 0 ), [RAM Total (GB)] )

// Quanto custa, em média, um notebook com placa de vídeo dedicada? -- Moeda R$, 2 casas
Preço Médio GPU Dedicada := CALCULATE ( [Preço Médio], fAnuncios[GPU_Tipo] = "Dedicada" )

// Que parte dos anúncios do recorte tem placa de vídeo dedicada? -- Porcentagem, 1 casa
% Anúncios GPU Dedicada := DIVIDE ( CALCULATE ( [Qtd Anúncios], fAnuncios[GPU_Tipo] = "Dedicada" ), [Qtd Anúncios] )

// ---------------- medidas de conferência (devem bater com a Etapa 2 / dar 0) ----------------

// Conferência: linhas de fAnuncios no modelo (= aceitas na Etapa 2) -- Inteiro, separador de milhar
Conf Linhas fAnuncios := COUNTROWS ( fAnuncios )

// Conferência: linhas de Rejeitados no modelo (= Etapa 2) -- Inteiro, separador de milhar
Conf Linhas Rejeitados := COUNTROWS ( Rejeitados )

// Conferência: aceitas + rejeitadas (= linhas lidas na Etapa 2) -- Inteiro, separador de milhar
Conf Linhas Lidas := [Conf Linhas fAnuncios] + [Conf Linhas Rejeitados]

// Integridade: anúncios sem modelo no cadastro (deve ser 0) -- Inteiro, separador de milhar
Conf Anuncios sem Modelo := COUNTROWS ( FILTER ( fAnuncios, ISBLANK ( RELATED ( dModelo[Modelo] ) ) ) ) + 0

// Integridade: anúncios sem processador em dCPU (deve ser 0) -- Inteiro, separador de milhar
Conf Anuncios sem CPU := COUNTROWS ( FILTER ( fAnuncios, ISBLANK ( RELATED ( dCPU[Fabricante] ) ) ) ) + 0

// Integridade: anúncios sem RAM em dRAM (deve ser 0) -- Inteiro, separador de milhar
Conf Anuncios sem RAM := COUNTROWS ( FILTER ( fAnuncios, ISBLANK ( RELATED ( dRAM[RAM] ) ) ) ) + 0

// Integridade: anúncios sem GPU em dGPU (deve ser 0) -- Inteiro, separador de milhar
Conf Anuncios sem GPU := COUNTROWS ( FILTER ( fAnuncios, ISBLANK ( RELATED ( dGPU[Tipo_da_GPU] ) ) ) ) + 0

// Integridade: anúncios com data fora do calendário (deve ser 0) -- Inteiro, separador de milhar
Conf Anuncios sem Data := COUNTROWS ( FILTER ( fAnuncios, ISBLANK ( RELATED ( dCalendario[Mes] ) ) ) ) + 0

// Integridade: chaves primárias repetidas nas dimensões (deve ser 0) -- Inteiro, separador de milhar
Conf PK Duplicada := ( COUNTROWS ( dModelo ) - DISTINCTCOUNT ( dModelo[Cod_Modelo] ) ) + ( COUNTROWS ( dCPU ) - DISTINCTCOUNT ( dCPU[CPU_Padrao] ) ) + ( COUNTROWS ( dRAM ) - DISTINCTCOUNT ( dRAM[RAM] ) ) + ( COUNTROWS ( dGPU ) - DISTINCTCOUNT ( dGPU[GPU_Padrao] ) ) + ( COUNTROWS ( dCalendario ) - DISTINCTCOUNT ( dCalendario[Data] ) )

// Integridade: o mesmo anúncio duas vezes na fato (deve ser 0) -- Inteiro, separador de milhar
Conf ID Duplicado := COUNTROWS ( fAnuncios ) - DISTINCTCOUNT ( fAnuncios[ID_Anuncio] )

// Conferência: a medida reproduz a coluna da Etapa 2 (deve ser 0) -- Moeda R$, 2 casas
Conf Dif Preco := ROUND ( SUM ( fAnuncios[Preco_BRL] ) - [Soma Preços], 2 )
